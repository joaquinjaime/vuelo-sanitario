      UNIQUEIDENTIFIER id PK
      UNIQUEIDENTIFIER document_item_id FK
      INT version UK
    }
    audit_events {
      BIGINT id PK
      UNIQUEIDENTIFIER flight_id FK
      UNIQUEIDENTIFIER actor_user_id FK
    }
    flight_audit_log {
      BIGINT id PK
