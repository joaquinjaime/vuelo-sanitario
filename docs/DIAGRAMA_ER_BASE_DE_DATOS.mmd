      UNIQUEIDENTIFIER flight_id FK
      INT version UK
    }
    hangar_info {
      UNIQUEIDENTIFIER id PK
      UNIQUEIDENTIFIER flight_id FK
      INT version UK
    }
    aa2000_coordination {
      UNIQUEIDENTIFIER id PK
      UNIQUEIDENTIFIER flight_id FK
