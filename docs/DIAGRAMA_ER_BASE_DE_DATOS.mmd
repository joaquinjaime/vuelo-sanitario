    }
    airports {
      UNIQUEIDENTIFIER id PK
      NVARCHAR codigo_oaci UK
      NVARCHAR codigo_iata UK
    }
    aircraft {
      UNIQUEIDENTIFIER id PK
      NVARCHAR matricula UK
    }
    crew_roles {
      UNIQUEIDENTIFIER id PK
      NVARCHAR codigo UK
    }
    flight_statuses {
      UNIQUEIDENTIFIER id PK
      NVARCHAR codigo UK
    }
    flight_priorities {
