# PLANTILLA de producción. Copiar a .env.production (ignorado por Git) y completar cada <definir>. No guardar valores reales en el repositorio.
# Se usa con: docker compose --env-file .env.production -f docker-compose.yml -f docker-compose.prod.yml --profile antimalware ...
# Esta plantilla NO indica que la producción esté lista: ver docs/PREPARACION_PRODUCCION_I57_2026-10-28.md y docs/PROCEDIMIENTO_ACTUALIZACION_V47_V60.md.

# --- Base de datos (SQL Server exige 8+ caracteres de tres clases; sin comilla simple) ---
MSSQL_SA_PASSWORD=<definir>
# Cuenta de la APLICACIÓN: sólo datos (db_datareader/db_datawriter). Es la única que recibe el backend.
DB_USERNAME=vuelos_app
DB_PASSWORD=<definir>
# Cuenta de MIGRACIONES (db_owner): distinta de la anterior. La consumen db-init (alta) y el ayudante de migración; docker-compose.prod.yml la retira del entorno del backend.
MIGRATION_DB_USERNAME=vuelos_migrator
MIGRATION_DB_PASSWORD=<definir, distinta de DB_PASSWORD>

# --- Sesiones: al menos 32 bytes aleatorios (openssl rand -base64 48). Rotarlo invalida sesiones y códigos de verificación de correo pendientes ---
JWT_SECRET=<definir>

# --- Entrada del sistema ---
FRONTEND_PORT=80
CORS_ALLOWED_ORIGIN=<https://dirección pública de la aplicación>
APP_PUBLIC_URL=<https://dirección pública de la aplicación>
MAX_PDF_BYTES=10485760

# --- Administrador de arranque: sólo para el primer inicio; RETIRAR estas tres variables cuando exista un administrador ---
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=

# --- Antivirus (obligatorio en producción). Si clamd corre en otro equipo, APP_ANTIMALWARE_HOST apunta a ese equipo (red privada, puerto 3310 filtrado) ---
APP_ANTIMALWARE_HOST=clamav
APP_ANTIMALWARE_MAX_SIGNATURE_AGE_DAYS=7

# --- Correo (pendiente de proveedor). Con credenciales se exige MAIL_STARTTLS=true o MAIL_SSL=true ---
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_STARTTLS=true
MAIL_SSL=false
MAIL_FROM=

# --- Avisos de vencimiento de habilitaciones: 60,30,7,0 es una PROPUESTA. Poner APPROVED=true sólo cuando el negocio la apruebe ---
APP_CREDENTIAL_EXPIRY_NOTICE_DAYS=60,30,7,0
APP_CREDENTIAL_EXPIRY_APPROVED=false

# --- Límites de recursos (punto de partida; ajustar al equipo de producción) ---
PROD_SQLSERVER_MEM_LIMIT=3g
PROD_SQLSERVER_MEMORY_LIMIT_MB=2048
PROD_BACKEND_MEM_LIMIT=768m
PROD_CLAMAV_MEM_LIMIT=3g
