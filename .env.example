# Copy this file to .env and replace every placeholder. Never commit .env.
# SQL Server requires 8+ characters from at least three character classes.
# Do not use a single quote (') in these two passwords: the idempotent init script rejects it.
MSSQL_SA_PASSWORD=ReplaceWithAStrongSaPassword_2026!
# E2E uses a different administrator secret. Store its real value in ignored .env.e2e.
E2E_MSSQL_SA_PASSWORD=ReplaceWithADifferentE2ePassword_2026!
# Cuenta de la APLICACIÓN: sólo lectura y escritura de datos (db_datareader/db_datawriter); no puede ejecutar DDL.
DB_USERNAME=vuelos_app
DB_PASSWORD=ReplaceWithAStrongAppPassword_2026!
# Cuenta de MIGRACIONES (db_owner): la usa Flyway; debe ser otra cuenta y otra contraseña. En producción NO se entrega al backend (sólo al procedimiento controlado).
MIGRATION_DB_USERNAME=vuelos_migrator
MIGRATION_DB_PASSWORD=ReplaceWithADifferentMigrationPassword_2026!
# Generate at least 32 random bytes, for example: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES

# Optional runtime configuration
FRONTEND_PORT=80
MAX_PDF_BYTES=10485760
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=

# Correo saliente para verificar correos de contacto (opcional). Sin MAIL_ENABLED=true y un servidor SMTP, el sistema informa
# "servicio de correo no configurado": no envía nada, no simula entregas y ningún correo queda verificado. Nunca guarde credenciales
# reales en el repositorio: complételas sólo en su .env local (ignorado por Git).
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_STARTTLS=true
MAIL_SSL=false
# Remitente de los mensajes (debe estar autorizado en su servidor SMTP).
MAIL_FROM=
# Dirección pública de la aplicación, que se menciona en el mensaje con el código.
APP_PUBLIC_URL=
# OTP de correo: seis dígitos; 10 minutos, cinco intentos y 60 segundos son mínimos de seguridad aplicados por el backend.
# EMAIL_VERIFICATION_CODE_MINUTES=10
# EMAIL_VERIFICATION_MAX_ATTEMPTS=5
# EMAIL_VERIFICATION_RESEND_SECONDS=60
# EMAIL_VERIFICATION_MAX_PER_EMAIL_PER_DAY=5
# EMAIL_VERIFICATION_MAX_PER_USER_PER_DAY=10
# Límite adicional por origen de red directo, con huella HMAC persistida (no confía en X-Forwarded-For).
# EMAIL_VERIFICATION_MAX_PER_ORIGIN_PER_DAY=50

# Análisis antimalware de la documentación de habilitaciones (clamd). Sin analizador, la documentación queda en cuarentena y no puede aprobarse.
# Producción: `docker compose --profile antimalware up -d clamav` (base completa con freshclam, ~2 GB de RAM) y APP_ANTIMALWARE_ENABLED=true.
APP_ANTIMALWARE_ENABLED=false
APP_ANTIMALWARE_HOST=
APP_ANTIMALWARE_PORT=3310
# Avisos de vencimiento de habilitaciones (días antes; 0 = el día del vencimiento) y revisión de vuelos abiertos tras cambiar una política.
# APP_CREDENTIAL_EXPIRY_NOTICE_DAYS=60,30,7,0
# APP_CREW_ELIGIBILITY_POLICY_REVIEW_ENABLED=true
